# Example .env for development using SQLite (default)
# NODE_ENV=development
```bash
# Example .env for development (default: MySQL)
# DATABASE_URL_DEV=./data/dev.sqlite
# JWT_SECRET=change-me

# Example .env for development using MySQL
# NODE_ENV=development
# DATABASE_TYPE_DEV=mysql
# DATABASE_HOST_DEV=127.0.0.1
# DATABASE_PORT_DEV=3306
# DATABASE_USERNAME_DEV=root
# DATABASE_PASSWORD_DEV=secret
# DATABASE_NAME_DEV=app_dev
# JWT_SECRET=change-me

# Example .env for production using MySQL
# NODE_ENV=production
# DATABASE_TYPE_PROD=mysql
# DATABASE_HOST_PROD=prod-db-host
# DATABASE_PORT_PROD=3306
# DATABASE_USERNAME_PROD=produser
# DATABASE_PASSWORD_PROD=prodpass
# DATABASE_NAME_PROD=app_prod
# JWT_SECRET=change-me
